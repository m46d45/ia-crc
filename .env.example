# Copy to .env.local for local overrides (optional).

# Postgres (Neon). When unset, the app uses embedded PGLite for local/preview.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public site hostname used for absolute Open Graph image URLs.
# VITE_PUBLIC_HOSTNAME=ia-crc.net

# Better Auth (optional). Leave unset for a public brochure site.
# Set VITE_SHOW_AUTH_UI=true to show Sign in in the header.
# VITE_SHOW_AUTH_UI=false
# VITE_AUTH_ENABLED=false
# BETTER_AUTH_URL=https://ia-crc.net
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# When set, new publication submissions stay pending until approved:
#   curl -X POST /api/publications \
#     -H 'content-type: application/json' \
#     -H "x-admin-token: $PUBLICATIONS_ADMIN_TOKEN" \
#     -d '{"action":"approve","id":"<publication-id>"}'
# PUBLICATIONS_ADMIN_TOKEN=
